# Byte-compiled / caches
__pycache__/
*.py[cod]
*$py.class
*.pyo
.Python

# Virtual environments
venv/
.venv/
.venv311/
env/

# Secrets and local env
.env
.env.*

# Streamlit local state / cache (if Streamlit writes under project dir)
.streamlit/secrets.toml

# Opt-in telemetry (JSONL append-only — never committed)
logs/
*.jsonl

# Local logs
*.log

# Phase 5 live API bundle cache + local rate-limit counter
# Keep only the live_bundles placeholder so the tree exists in a fresh clone.
cache/**
!cache/live_bundles/
!cache/live_bundles/.gitkeep

# Raw / processed API response dumps (local runtime audit trail)
data/raw/**
!data/raw/.gitkeep

# Testing / coverage
.pytest_cache/
.coverage
htmlcov/

# Type checkers / tooling
.mypy_cache/
.ruff_cache/

# Editors / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Builds
build/
dist/
*.egg-info/

